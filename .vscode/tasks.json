{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Start Emulator",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\start-emulator.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Android: Build Debug APK",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-debug.ps1"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: Install Debug APK",
      "type": "shell",
      "command": "adb",
      "args": [
        "install",
        "-r",
        "${workspaceFolder}\\app\\build\\outputs\\apk\\debug\\app-debug.apk"
      ],
      "dependsOn": [
        "Android: Build Debug APK"
      ],
      "problemMatcher": []
    },
    {
      "label": "Android: Launch App",
      "type": "shell",
      "command": "adb",
      "args": [
        "shell",
        "monkey",
        "-p",
        "com.example.dogrundetector",
        "-c",
        "android.intent.category.LAUNCHER",
        "1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Android: Build Install Launch",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Android: Build Debug APK",
        "Android: Install Debug APK",
        "Android: Launch App"
      ],
      "problemMatcher": []
    }
  ]
}
